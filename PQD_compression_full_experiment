c, marker=mk,\n                    ls=ls, ms=3.5, capsize=2, lw=0.9, label=LABEL[v])\n    ax.set_xticks(xs); ax.set_xticklabels(xl); ax.set_xlabel(\"Test SNR (dB)\"); ax.set_title(TITLE[a])\n    ax.grid(alpha=0.3, lw=0.4)\naxs[0].set_ylabel(\"Macro-F1 (%)\")\naxs[1].legend(fontsize=6.5, ncol=1, frameon=False, loc=\"lower left\", bbox_to_anchor=(1.0, 0.0))\nfig.tight_layout(); fig.savefig(os.path.join(FIG, \"Fig_f1_vs_snr.png\")); fig.savefig(os.path.join(FIG, \"Fig_f1_vs_snr.pdf\")); plt.close(fig)\n\nfig, axs = plt.subplots(1, 2, figsize=(7.0, 3.0))\nfor ax, a in zip(axs, ARCHS):\n    for v in VARIANTS:\n        x = summ[(summ.arch == a) & (summ.variant == v) & (summ.snr == \"20dB\")]\n        if x.empty: continue\n        x = x.iloc[0]; c, mk, _ = STYLE[v]\n        size = x.gzip_kb if v.startswith(\"up\") else x.tflite_kb    # sparse models only shrink when compressed\n        ax.errorbar(size, 100*x.macro_f1_mean, yerr=100*(0 if np.isnan(x.macro_f1_std) else x.macro_f1_std),\n                    color=c, marker=mk, ms=5, capsize=2, ls=\"none\", label=LABEL[v])\n    ax.set_xscale(\"log\"); ax.set_xlabel(\"Model size (KB, log scale)\"); ax.set_title(TITLE[a] + \", 20 dB\")\n    ax.grid(alpha=0.3, lw=0.4, which=\"both\")\naxs[0].set_ylabel(\"Macro-F1 at 20 dB (%)\")\naxs[1].legend(fontsize=6.5, frameon=False, loc=\"lower left\", bbox_to_anchor=(1.0, 0.0))\nfig.tight_layout(); fig.savefig(os.path.join(FIG, \"Fig_size_vs_f1_20dB.png\")); fig.savefig(os.path.join(FIG, \"Fig_size_vs_f1_20dB.pdf\")); plt.close(fig)\n\ndef summed_cm(arch, variant):\n    tot = np.zeros((NC, NC), int)\n    for f in glob.glob(os.path.join(RES, f\"cm20_{arch}_s*.npz\")):\n        z = np.load(f)\n        for k in z.files:\n            if k.startswith(f\"{arch}__{variant}__\"): tot += z[k]\n    return tot\n\nfor a in ARCHS:\n    fig, axs = plt.subplots(1, 2, figsize=(7.0, 3.6))\n    for ax, v in zip(axs, [\"fp32\", \"qat_int8\"]):\n        cm = summed_cm(a, v); cmn = cm / np.maximum(cm.sum(1, keepdims=True), 1)\n        ax.imshow(cmn, cmap=\"Greys\", vmin=0, vmax=1)\n        for i in range(NC):\n            for j in range(NC):\n                if cmn[i, j] >= 0.01:\n                    ax.text(j, i, f\"{100*cmn[i,j]:.0f}\", ha=\"center\", va=\"center\", fontsize=4.5,\n                            color=\"white\" if cmn[i, j] > 0.5 else \"black\")\n        ax.set_xticks(range(NC)); ax.set_yticks(range(NC))\n        ax.set_xticklabels([f\"C{i}\" for i in range(NC)], fontsize=5.5, rotation=90)\n        ax.set_yticklabels([f\"C{i}\" for i in range(NC)], fontsize=5.5)\n        ax.set_xlabel(\"Predicted class\"); ax.set_ylabel(\"True class\"); ax.set_title(f\"{LABEL[v]}\", fontsize=8)\n    fig.tight_layout(); fig.savefig(os.path.join(FIG, f\"Fig_confusion_20dB_{a}.png\")); fig.savefig(os.path.join(FIG, f\"Fig_confusion_20dB_{a}.pdf\")); plt.close(fig)\n\nwith open(os.path.join(RES, \"environment.json\"), \"w\") as f:\n    json.dump({\"tensorflow\": tf.__version__, \"tf_keras\": keras.__version__, \"tfmot\": tfmot.__version__,\n               \"numpy\": np.__version__, \"python\": platform.python_version(), \"cpu\": platform.processor(),\n               \"gpu\": [g.name for g in gpus]}, f, indent=2)\nprint(\"Figures saved to\", FIG)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-21T17:00:37.521341Z","iopub.execute_input":"2026-11-21T17:00:37.522017Z","iopub.status.idle":"2026-11-21T17:00:44.593088Z","shell.execute_reply.started":"2026-11-21T17:00:37.521996Z","shell.execute_reply":"2026-11-21T17:00:44.592418Z"}},"outputs":[{"name":"stdout","text":"Figures saved to /kaggle/working/PQD_paper/figures\n","output_type":"stream"}],"execution_count":14},{"id":"c229d9ed-5038-4563-b2f1-7a70409e0149","cell_type":"code","source":"# Cell 15 — pack everything for download\nimport shutil\npack = os.path.join(os.path.dirname(os.path.abspath(ROOT)), \"PQD_results_pack\")\nif os.path.exists(pack): shutil.rmtree(pack)\nfor sub in [\"results\", \"figures\", \"