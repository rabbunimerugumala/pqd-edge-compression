{"metadata":{"kernelspec":{"display_name":"Python 3","language":"python","name":"python3"},"language_info":{"name":"python","version":"3.13.16","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"nvidiaTeslaT4","dataSources":[],"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":5,"nbformat":4,"cells":[{"id":"18229572-a9c3-4e58-9dd9-d75db1fc7439","cell_type":"markdown","source":"# Quantization and Pruning of Compact 1D-CNNs for Edge PQD Classification\n**Full experiment notebook (Kaggle), version 2.** Author: Rabbuni Merugumala\n\nv2 changes after the pilot run: 4000 training signals per class, longer training, longer pruning/QAT fine-tuning, and a fix so magnitude-pruned models always keep their target sparsity.\n\nRun order: **Run All**. Every cell is checkpointed: if the Kaggle session stops, run all again and finished seeds are skipped.\n\nWhat this notebook does:\n1. Generates a 16-class synthetic PQD dataset (random initial phase; plus an extra 49.5–50.5 Hz frequency-deviation test set) (IEEE 1159 based models, parameter ranges from Machlev et al., 2022), 50 Hz, 3.2 kHz, 640 samples.\n2. Trains two compact baselines: a plain 1D-CNN and 1D-CCANet-3 (Bai et al., 2026; output layer adapted to 16 classes).\n3. Builds 9 variants per baseline: FP32, PTQ-INT8, QAT-INT8, structured filter pruning 50% / 75% (physical rebuild), structured pruning + QAT, unstructured magnitude pruning 50% / 75%.\n4. Tests every variant **as a TFLite model** on fixed test sets at clean, 50, 40, 30, 20 and 10 dB SNR.\n5. Repeats everything for 5 seeds (42–46) and writes CSV tables and 600-dpi figures.\n\n**Settings:** Accelerator = GPU (P100 or T4). Internet = ON (for the pip install in cell 1).","metadata":{}},{"id":"0c3ddf8e-5620-4533-819e-987c3ecd8692","cell_type":"code","source":"# Cell 1 — install (must run before TensorFlow is imported)\nimport importlib.metadata as md, subprocess, sys, os\nos.environ[\"TF_USE_LEGACY_KERAS\"] = \"1\"          # tfmot needs Keras 2 (tf_keras)\nos.environ[\"TF_CPP_MIN_LOG_LEVEL\"] = \"2\"\n_tfv = md.version(\"tensorflow\")\n_mm = \".\".join(_tfv.split(\".\")[:2])\n_need = []\ntry:\n    md.version(\"tf_keras\")\nexcept md.PackageNotFoundError:\n    _need.append(f\"tf_keras~={_mm}.0\")\ntry:\n    md.version(\"tensorflow-model-optimization\")\nexcept md.PackageNotFoundError:\n    _need.append(\"tensorflow-model-optimization\")\nif _need:\n    subprocess.check_call([sys.executable, \"-m\", \"pip\", \"install\", \"-q\", *_need])\nprint(\"TensorFlow\", _tfv, \"| installed:\", _need or \"nothing needed\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-21T13:42:38.678878Z","iopub.execute_input":"2026-11-21T13:42:38.679372Z","iopub.status.idle":"2026-11-21T13:42:42.051445Z","shell.execute_reply.started":"2026-11-21T13:42:38.679319Z","shell.execute_reply":"2026-11-21T13:42:42.050606Z"}},"outputs":[{"name":"stderr","text":"ERROR: pip's dependency resolver does not currently take into account all the packages that are installed. This behaviour is the source of the following dependency conflicts.\ndopamine-rl 4.1.2 requires gym<=0.25.2, but you have gym 0.26.2 which is incompatible.\nydf 0.15.0 requires protobuf<7.0.0,>=5.29.1, but you have protobuf 7.36.2 which is incompatible.\n","output_type":"stream"},{"name":"stdout","text":"TensorFlow 2.21.0 | installed: ['tensorflow-model-optimization']\n","output_type":"stream"}],"execution_count":1},{"id":"228b25ca-a664-4176-b4ff-f6e822905635","cell_type":"code","source":"# Cell 2 — imports and configuration\nimport json, time, gzip, glob, platform, warnings, logging\nwarnings.filterwarnings(\"ignore\")\nimport numpy as np\nimport pandas as pd\nimport tensorflow as tf\nimport tf_keras as keras\nfrom tf_keras import layers\nimport tensorflow_model_optimization as tfmot\nfrom sklearn.metrics import accuracy_score, f1_score, confusion_matrix\nimport matplotlib\nmatplotlib.use(\"Agg\")\nimport matplotlib.pyplot as plt\ntf.get_logger().setLevel(logging.ERROR)\n\nQUICK = os.environ.get(\"PQD_QUICK\", \"0\") == \"1\"   # tiny smoke test; keep False on Kaggle\n\nif os.path.exists(\"/kaggle/working\"):\n    ROOT = \"/kaggle/working/PQD_paper\"\nelse:\n    ROOT = os.environ.get(\"PQD_ROOT\", \"PQD_paper\")\nfor sub in [\"data\", \"models\", \"results\", \"figures\"]:\n    os.makedirs(os.path.join(ROOT, sub), exist_ok=True)\n\n# ---- signal settings (fixed by the study design) ----\nF0, FS, N_CYC = 50.0, 3200.0, 10\nN = int(FS / F0 * N_CYC)              # 640 samples\nT = 1.0 / F0                          # one cycle = 0.02 s\nt = np.arange(N) / FS\nW = 2 * np.pi * F0\n\nCLASSES = [\"Normal\", \"Sag\", \"Swell\", \"Interruption\", \"Harmonics\", \"Flicker\",\n           \"Osc. transient\", \"Imp. transient\", \"Notch\", \"Spike\",\n           \"Sag+Harm\", \"Swell+Harm\", \"Interr.+Harm\", \"Flicker+Harm\",\n           \"Flicker+Sag\", \"Flicker+Swell\"]\nNC = len(CLASSES)\n\n# ---- dataset size and noise ----\nN_TRAIN, N_VAL, N_TEST = 4000, 500, 300      # per class (test: per class per SNR level); Machlev used 4800, Bai 5000\nTRAIN_SNR = (20.0, 50.0)                      # uniform, as in Machlev et al. (2022)\nCLEAN_FRAC = 0.10                             # share of noise-free training signals\nTEST_SNRS = [None, 50, 40, 30, 20, 10]        # None = clean\nFDEV_RANGE, FDEV_SNR = (49.5, 50.5), 30       # extra out-of-distribution test: grid frequency deviation\nDATA_SEEDS = {\"train\": 2026, \"val\": 2027, \"test\": 2028}\n\n# ---- training ----\nSEEDS = [42, 43, 44, 45, 46]\nEPOCHS, PATIENCE, BATCH, LR = 120, 12, 64, 1e-3\nFT_EPOCHS, FT_LR = 30, 3e-4                   # fine-tuning after each pruning step (early stopping)\nQAT_EPOCHS, QAT_LR = 20, 1e-4\nUNSTR_EPOCHS = 30                             # sparsity ramps over the first 60%, then fixed\nPRUNE_STEPS = [0.25, 0.50, 0.75]              # iterative structured pruning schedule\nUNSTR_TARGETS = [0.50, 0.75]\nCALIB_N = 300                                 # PTQ calibration signals (noisy mix from train set)\nLAT_RUNS, LAT_WARMUP = 300, 30\n\nif QUICK:\n    N_TRAIN, N_VAL, N_TEST = 40, 10, 10\n    SEEDS = [42]\n    EPOCHS, FT_EPOCHS, QAT_EPOCHS, PATIENCE, UNSTR_EPOCHS = 2, 1, 1, 2, 3\n    LAT_RUNS, LAT_WARMUP, CALIB_N = 20, 5, 50\n\nARCHS = [\"cnn\", \"ccanet\"]\nVARIANTS = [\"fp32\", \"ptq_int8\", \"qat_int8\", \"sp50\", \"sp75\",\n            \"sp50_qat\", \"sp75_qat\", \"up50\", \"up75\"]\n\nCONFIG = {k: v for k, v in dict(globals()).items()\n          if k.isupper() and isinstance(v, (int, float, str, list, dict, tuple, type(None)))}\nwith open(os.path.join(ROOT, \"results\", \"config.json\"), \"w\") as f:\n    json.dump(CONFIG, f, indent=2, default=str)\ngpus = tf.config.list_physical_devices(\"GPU\")\nprint(\"ROOT:\", ROOT, \"| GPU:\", gpus, \"| QUICK:\", QUICK)\nprint(\"TF\", tf.__version__, \"| tf_keras\", keras.__version__, \"| tfmot\", tfmot.__version__)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-21T13:42:42.052881Z","iopub.execute_input":"2026-11-21T13:42:42.05317Z","iopub.status.idle":"2026-11-21T13:43:02.116908Z","shell.execute_reply.started":"2026-11-21T13:42:42.05315Z","shell.execute_reply":"2026-11-21T13:43:02.116026Z"}},"outputs":[{"name":"stdout","text":"ROOT: /kaggle/working/PQD_paper | GPU: [PhysicalDevice(name='/physical_device:GPU:0', device_type='GPU'), PhysicalDevice(name='/physical_device:GPU:1', device_type='GPU')] | QUICK: False\nTF 2.21.0 | tf_keras 2.21.0 | tfmot 0.8.1\n","output_type":"stream"}],"execution_count":2},{"id":"0ea6d49c-155c-43c9-a431-39694c06cea8","cell_type":"code","source":"# Cell 3 — PQD signal generator (16 classes, parameter ranges of Machlev et al. 2022, Table I)\ndef u(a, b):\n    \"\"\"Rectangular window u(t-a) - u(t-b).\"\"\"\n    return ((t >= a) & (t < b)).astype(np.float64)\n\ndef window(rng, dmin, dmax):\n    d = rng.uniform(dmin, dmax)\n    t1 = rng.uniform(0.0, t[-1] - d)\n    return t1, t1 + d\n\n# Every signal gets a random initial phase (the recording window is not synchronised to a zero\n# crossing), and optionally a fundamental frequency other than 50 Hz (used only for the\n# frequency-deviation test set). TH is the instantaneous phase angle of the fundamental.\nTH = None\nF_SIG = F0\n\ndef harmonic_wave(rng):\n    a3, a5, a7 = rng.uniform(0.05, 0.15, 3)\n    a1 = np.sqrt(1.0 - (a3**2 + a5**2 + a7**2))\n    return a1*np.sin(TH) + a3*np.sin(3*TH) + a5*np.sin(5*TH) + a7*np.sin(7*TH)\n\ndef flicker_env(rng):\n    af, beta = rng.uniform(0.1, 0.2), rng.uniform(5.0, 20.0)\n    return 1.0 + af*np.sin(2*np.pi*beta*t)\n\ndef notch_train(rng):\n    \"\"\"Rectangular pulses locked to the same point of every cycle, signed by the sine (Machlev et al.).\"\"\"\n    Tc = 1.0 / F_SIG\n    k = rng.uniform(0.1, 0.4)\n    width = rng.uniform(0.01*Tc, 0.05*Tc)\n    t1 = rng.uniform(0.0, 0.5*Tc - width)\n    tc = np.mod(TH, 2*np.pi) / (2*np.pi) * Tc          # time since the start of the current cycle\n    p = ((tc >= t1) & (tc < t1 + width)).astype(np.float64)\n    return k * np.sign(np.sin(TH)) * p\n\ndef make_signal(c, rng, f_range=None):\n    global TH, F_SIG\n    F_SIG = F0 if f_range is None else rng.uniform(*f_range)\n    TH = 2*np.pi*F_SIG*t + rng.uniform(0.0, 2*np.pi)\n    s = np.sin(TH)\n    if c == 0:                                   # Normal\n        a = rng.uniform(0.0, 0.04); t1, t2 = window(rng, T, 9*T)\n        return (1 + rng.choice([-1, 1])*a*u(t1, t2)) * s\n    if c == 1:                                   # Sag\n        a = rng.uniform(0.1, 0.9); t1, t2 = window(rng, T, 9*T)\n        return (1 - a*u(t1, t2)) * s\n    if c == 2:                                   # Swell\n        a = rng.uniform(0.1, 0.8); t1, t2 = window(rng, T, 9*T)\n        return (1 + a*u(t1, t2)) * s\n    if c == 3:                                   # Interruption\n        a = rng.uniform(0.9, 1.0); t1, t2 = window(rng, T, 9*T)\n        return (1 - a*u(t1, t2)) * s\n    if c == 4:                                   # Harmonics\n        return harmonic_wave(rng)\n    if c == 5:                                   # Flicker\n        return flicker_env(rng) * s\n    if c == 6:                                   # Oscillatory transient\n        a = rng.uniform(0.1, 0.8); t1, t2 = window(rng, 0.5*T, 3*T)\n        tau, fn = rng.uniform(0.008, 0.040), rng.uniform(300.0, 900.0)\n        return s + a*np.exp(-(t - t1)/tau)*np.sin(2*np.pi*fn*(t - t1))*u(t1, t2)\n    if c == 7:                                   # Impulsive transient\n        a = rng.uniform(0.1, 0.414); t1, t2 = window(rng, T/20, T/10)\n        return (1 - a*u(t1, t2)) * s\n    if c == 8:                                   # Notch\n        return s - notch_train(rng)\n    if c == 9:                                   # Spike\n        return s + notch_train(rng)\n    if c == 10:                                  # Sag + harmonics\n        a = rng.uniform(0.1, 0.9); t1, t2 = window(rng, T, 9*T)\n        return (1 - a*u(t1, t2)) * harmonic_wave(rng)\n    if c == 11:                                  # Swell + harmonics\n        a = rng.uniform(0.1, 0.8); t1, t2 = window(rng, T, 9*T)\n        return (1 + a*u(t1, t2)) * harmonic_wave(rng)\n    if c == 12:                                  # Interruption + harmonics\n        a = rng.uniform(0.9, 1.0); t1, t2 = window(rng, T, 9*T)\n        return (1 - a*u(t1, t2)) * harmonic_wave(rng)\n    if c == 13:                                  # Flicker + harmonics\n        return flicker_env(rng) * harmonic_wave(rng)\n    if c == 14:                                  # Flicker + sag\n        a = rng.uniform(0.1, 0.9); t1, t2 = window(rng, T, 9*T)\n        return flicker_env(rng) * (1 - a*u(t1, t2)) * s\n    if c == 15:                                  # Flicker + swell\n        a = rng.uniform(0.1, 0.8); t1, t2 = window(rng, T, 9*T)\n        return flicker_env(rng) * (1 + a*u(t1, t2)) * s\n    raise ValueError(c)\n\ndef add_awgn(x, snr_db, rng):\n    p = np.mean(x**2)\n    return x + rng.normal(0.0, np.sqrt(p / 10**(snr_db/10)), x.shape)\n\ndef build_set(n_per_class, seed, snr=None, snr_range=None, clean_frac=0.0, f_range=None):\n    rng = np.random.default_rng(seed)\n    X = np.zeros((n_per_class*NC, N), np.float32)\n    y = np.repeat(np.arange(NC), n_per_class).astype(np.int64)\n    snrs = np.full(len(y), np.nan, np.float32)\n    for i, c in enumerate(y):\n        x = make_signal(int(c), rng, f_range)\n        if snr is not None:\n            x = add_awgn(x, snr, rng); snrs[i] = snr\n        elif snr_range is not None and rng.random() >= clean_frac:\n            s_db = rng.uniform(*snr_range); x = add_awgn(x, s_db, rng); snrs[i] = s_db\n        X[i] = x\n    p = rng.permutation(len(y))\n    return X[p, :, None], y[p], snrs[p]\n\ndef snr_tag(s):\n    return \"clean\" if s is None else f\"{s}dB\"\n\nDATA = os.path.join(ROOT, \"data\")\nif not os.path.exists(os.path.join(DATA, \"test_fdev.npz\")) or QUICK:\n    t0 = time.time()\n    Xtr, ytr, str_ = build_set(N_TRAIN, DATA_SEEDS[\"train\"], snr_range=TRAIN_SNR, clean_frac=CLEAN_FRAC)\n    Xva, yva, sva = build_set(N_VAL, DATA_SEEDS[\"val\"], snr_range=TRAIN_SNR, clean_frac=CLEAN_FRAC)\n    np.savez_compressed(os.path.join(DATA, \"train.npz\"), X=Xtr, y=ytr, snr=str_)\n    np.savez_compressed(os.path.join(DATA, \"val.npz\"), X=Xva, y=yva, snr=sva)\n    for j, s in enumerate(TEST_SNRS):        # each SNR level gets its own independent signals\n        Xte, yte, _ = build_set(N_TEST, DATA_SEEDS[\"test\"] + 10*j, snr=s)\n        np.savez_compressed(os.path.join(DATA, f\"test_{snr_tag(s)}.npz\"), X=Xte, y=yte)\n    Xf, yf, _ = build_set(N_TEST, DATA_SEEDS[\"test\"] + 99, snr=FDEV_SNR, f_range=FDEV_RANGE)\n    np.savez_compressed(os.path.join(DATA, \"test_fdev.npz\"), X=Xf, y=yf)\n    print(f\"Dataset generated in {time.time()-t0:.1f} s\")\n\nd = np.load(os.path.join(DATA, \"train.npz\")); Xtr, ytr = d[\"X\"], d[\"y\"]\nd = np.load(os.path.join(DATA, \"val.npz\"));   Xva, yva = d[\"X\"], d[\"y\"]\nTEST = {}\nfor s in TEST_SNRS:\n    d = np.load(os.path.join(DATA, f\"test_{snr_tag(s)}.npz\")); TEST[snr_tag(s)] = (d[\"X\"], d[\"y\"])\nd = np.load(os.path.join(DATA, \"test_fdev.npz\")); TEST[\"fdev\"] = (d[\"X\"], d[\"y\"])   # 49.5-50.5 Hz, 30 dB\nprint(\"train\", Xtr.shape, \"val\", Xva.shape, \"test per SNR\", TEST[\"clean\"][0].shape)\nprint(\"class counts (train):\", np.bincount(ytr))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-21T13:43:02.117963Z","iopub.execute_input":"2026-11-21T13:43:02.118458Z","iopub.status.idle":"2026-11-21T13:43:25.466796Z","shell.execute_reply.started":"2026-11-21T13:43:02.118437Z","shell.execute_reply":"2026-11-21T13:43:25.465912Z"}},"outputs":[{"name":"stdout","text":"Dataset generated in 21.9 s\ntrain (64000, 640, 1) val (8000, 640, 1) test per SNR (4800, 640, 1)\nclass counts (train): [4000 4000 4000 4000 4000 4000 4000 4000 4000 4000 4000 4000 4000 4000\n 4000 4000]\n","output_type":"stream"}],"execution_count":3},{"id":"ea353121-3ecd-4898-87d3-e6e84c9de2d2","cell_type":"code","source":"# Cell 4 — figure style and waveform figure (Fig. 2 of the paper)\nplt.rcParams.update({\"font.family\": \"sans-serif\", \"font.sans-serif\": [\"Arial\", \"Liberation Sans\", \"DejaVu Sans\"],\n                     \"font.size\": 8, \"axes.linewidth\": 0.6, \"lines.linewidth\": 0.9,\n                     \"savefig.dpi\": 600, \"savefig.bbox\": \"tight\"})\nFIG = os.path.join(ROOT, \"figures\")\n\nrng_fig = np.random.default_rng(7)\nfig, axs = plt.subplots(4, 4, figsize=(7.0, 5.6), sharex=True, sharey=True)\nfor c, ax in enumerate(axs.flat):\n    ax.plot(t*1000, make_signal(c, rng_fig), color=\"black\")\n    ax.set_title(f\"C{c}: {CLASSES[c]}\", fontsize=7.5)\n    ax.set_ylim(-2.0, 2.0); ax.grid(alpha=0.25, linewidth=0.4)\nfor ax in axs[-1]: ax.set_xlabel(\"Time (ms)\")\nfor ax in axs[:, 0]: ax.set_ylabel(\"Voltage (p.u.)\")\nfig.tight_layout()\nfig.savefig(os.path.join(FIG, \"Fig_waveforms_16class.png\")); fig.savefig(os.path.join(FIG, \"Fig_waveforms_16class.pdf\"))\nplt.close(fig)\nprint(\"saved waveform figure\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-21T13:43:25.468661Z","iopub.execute_input":"2026-11-21T13:43:25.469134Z","iopub.status.idle":"2026-11-21T13:43:29.107651Z","shell.execute_reply.started":"2026-11-21T13:43:25.469111Z","shell.execute_reply":"2026-11-21T13:43:29.106955Z"}},"outputs":[{"name":"stdout","text":"saved waveform figure\n","output_type":"stream"}],"execution_count":4},{"id":"1334e93f-9379-436b-b4fb-e005eafc4331","cell_type":"code","source":"# Cell 5 — baseline models\n# Conv1D layers are written as mathematically identical Conv2D layers with 1 x k kernels on a\n# (1, 640, 1) input. TFLite executes Conv1D this way internally, and tfmot QAT supports only the\n# 2-D layers (it folds Conv2D+BatchNorm during QAT; Conv1D/MaxPooling1D are not in its registry).\ndef conv(w, k, name, padding=\"valid\"):\n    return layers.Conv2D(int(w), (1, k), padding=padding, use_bias=False, name=name)\n\ndef build_cnn(widths=(16, 32, 64), n_classes=NC):\n    \"\"\"Plain compact 1D-CNN: 3 x [Conv-BN-ReLU], wide first kernel, GAP head.\"\"\"\n    inp = keras.Input((N, 1), name=\"input\")\n    x = layers.Reshape((1, N, 1), name=\"to2d\")(inp)\n    for i, (w, k) in enumerate(zip(widths, (7, 5, 3))):\n        x = conv(w, k, f\"conv{i+1}\", padding=\"same\")(x)\n        x = layers.BatchNormalization(name=f\"bn{i+1}\")(x)\n        x = layers.ReLU(name=f\"relu{i+1}\")(x)\n        if i < 2:\n            x = layers.MaxPooling2D((1, 4), name=f\"pool{i+1}\")(x)\n    x = layers.GlobalAveragePooling2D(name=\"gap\")(x)\n    x = layers.Dropout(0.3, name=\"drop\")(x)\n    out = layers.Dense(n_classes, activation=\"softmax\", name=\"fc\")(x)\n    return keras.Model(inp, out, name=\"cnn\")\n\ndef build_ccanet(widths=(6, 16, 16), n_classes=NC):\n    \"\"\"1D-CCANet-3 of Bai et al. (2026), Table 4: 3 conv layers (k=5, no bias),\n    ECA-style cross-channel attention (k=3) + BN, flatten, bias-free FC.\"\"\"\n    inp = keras.Input((N, 1), name=\"input\")\n    x = layers.Reshape((1, N, 1), name=\"to2d\")(inp)\n    x = conv(widths[0], 5, \"conv1\")(x)\n    x = layers.ReLU(name=\"relu1\")(x)\n    x = layers.MaxPooling2D((1, 3), (1, 3), name=\"pool1\")(x)\n    x = conv(widths[1], 5, \"conv2\")(x)\n    x = layers.ReLU(name=\"relu2\")(x)\n    x = layers.MaxPooling2D((1, 3), (1, 3), name=\"pool2\")(x)\n    f = conv(widths[2], 5, \"conv3\")(x)                                           # (1, L, C)\n    C = int(widths[2])\n    a = layers.GlobalAveragePooling2D(name=\"eca_gap\")(f)                         # (C,)\n    a = layers.Reshape((1, C, 1), name=\"eca_r1\")(a)                              # channels as a sequence\n    a = layers.Conv2D(1, (1, 3), padding=\"same\", use_bias=False, name=\"eca_conv\")(a)\n    a = layers.Activation(\"sigmoid\", name=\"eca_sig\")(a)\n    a = layers.Reshape((1, 1, C), name=\"eca_r2\")(a)\n    x = layers.Multiply(name=\"eca_mul\")([f, a])\n    x = layers.BatchNormalization(name=\"bn\")(x)\n    x = layers.ReLU(name=\"relu3\")(x)\n    x = layers.Flatten(name=\"flat\")(x)\n    out = layers.Dense(n_classes, use_bias=False, activation=\"softmax\", name=\"fc\")(x)\n    return keras.Model(inp, out, name=\"ccanet\")\n\nBUILDERS = {\"cnn\": build_cnn, \"ccanet\": build_ccanet}\nBASE_WIDTHS = {\"cnn\": (16, 32, 64), \"ccanet\": (6, 16, 16)}\n\ndef n_trainable(m):\n    return int(sum(np.prod(v.shape) for v in m.trainable_weights))\n\nfor a in ARCHS:\n    m = BUILDERS[a]()\n    print(f\"{a}: trainable params = {n_trainable(m):,}\")\n# check: CCANet with 10 classes must give Bai's 12,225 parameters\nprint(\"CCANet-3 (10 classes) trainable params:\", n_trainable(build_ccanet(n_classes=10)), \"(Bai et al.: 12,225)\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-21T13:43:29.108695Z","iopub.execute_input":"2026-11-21T13:43:29.109401Z","iopub.status.idle":"2026-11-21T13:43:29.913897Z","shell.execute_reply.started":"2026-11-21T13:43:29.109377Z","shell.execute_reply":"2026-11-21T13:43:29.913202Z"}},"outputs":[{"name":"stdout","text":"cnn: trainable params = 10,080\nccanet: trainable params = 18,465\nCCANet-3 (10 classes) trainable params: 12225 (Bai et al.: 12,225)\n","output_type":"stream"}],"execution_count":5},{"id":"4cb4ec6e-c8b1-4f86-a805-2a8b7211bda3","cell_type":"code","source":"# Cell 6 — training helpers\ndef compile_model(m, lr):\n    m.compile(optimizer=keras.optimizers.Adam(lr), loss=\"sparse_categorical_crossentropy\", metrics=[\"accuracy\"])\n    return m\n\ndef fit(m, epochs, lr, extra_cb=(), patience=PATIENCE, early_stop=True):\n    compile_model(m, lr)\n    cbs = [keras.callbacks.ReduceLROnPlateau(\"val_loss\", factor=0.5, patience=max(2, patience//2), min_lr=1e-6),\n           *extra_cb]\n    if early_stop:   # never used for magnitude pruning: restoring a \"best\" epoch could undo the sparsity\n        cbs.insert(0, keras.callbacks.EarlyStopping(\"val_loss\", patience=patience, restore_best_weights=True))\n    h = m.fit(Xtr, ytr, validation_data=(Xva, yva), epochs=epochs, batch_size=BATCH,\n              shuffle=True, verbose=0, callbacks=cbs)\n    return h","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-21T13:43:29.914819Z","iopub.execute_input":"2026-11-21T13:43:29.915113Z","iopub.status.idle":"2026-11-21T13:43:29.92093Z","shell.execute_reply.started":"2026-11-21T13:43:29.915093Z","shell.execute_reply":"2026-11-21T13:43:29.920391Z"}},"outputs":[],"execution_count":6},{"id":"21b32ff5-01c4-46a2-b314-13f39487c586","cell_type":"code","source":"# Cell 7 — structured filter pruning with physical rebuild (L1-norm ranking, Li et al. 2017)\nCONV_NAMES = [\"conv1\", \"conv2\", \"conv3\"]\n\ndef structured_prune(model, arch, frac):\n    \"\"\"Remove the lowest-L1 filters of every conv layer so that each keeps\n    round((1-frac) * original width) filters, rebuild a smaller dense model, copy weights.\"\"\"\n    base = BASE_WIDTHS[arch]\n    keep = [max(2, int(round(w*(1-frac)))) for w in base]\n    idx = []\n    for name, k in zip(CONV_NAMES, keep):\n        K = model.get_layer(name).get_weights()[0]                 # (1, k, in, out)\n        l1 = np.abs(K).sum(axis=(0, 1, 2))\n        idx.append(np.sort(np.argsort(l1)[::-1][:k]))\n    new = BUILDERS[arch](widths=keep)\n    prev = np.arange(1)                                            # input has 1 channel\n    for name, ix in zip(CONV_NAMES, idx):\n        K = model.get_layer(name).get_weights()[0]\n        new.get_layer(name).set_weights([K[:, :, prev, :][:, :, :, ix]])\n        prev = ix\n    if arch == \"cnn\":\n        for i, ix in enumerate(idx):\n            new.get_layer(f\"bn{i+1}\").set_weights([w[ix] for w in model.get_layer(f\"bn{i+1}\").get_weights()])\n        Wd, bd = model.get_layer(\"fc\").get_weights()\n        new.get_layer(\"fc\").set_weights([Wd[idx[2], :], bd])\n    else:\n        new.get_layer(\"eca_conv\").set_weights(model.get_layer(\"eca_conv\").get_weights())\n        new.get_layer(\"bn\").set_weights([w[idx[2]] for w in model.get_layer(\"bn\").get_weights()])\n        Wd = model.get_layer(\"fc\").get_weights()[0]                 # (L*C, n), flatten order = (time, channel)\n        L = model.get_layer(\"conv3\").output_shape[2]\n        C = base[2] if Wd.shape[0] == L*base[2] else Wd.shape[0] // L\n        new.get_layer(\"fc\").set_weights([Wd.reshape(L, C, -1)[:, idx[2], :].reshape(L*len(idx[2]), -1)])\n    return new, keep","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-21T13:43:29.922159Z","iopub.execute_input":"2026-11-21T13:43:29.922505Z","iopub.status.idle":"2026-11-21T13:43:29.937818Z","shell.execute_reply.started":"2026-11-21T13:43:29.922484Z","shell.execute_reply":"2026-11-21T13:43:29.937008Z"}},"outputs":[],"execution_count":7},{"id":"4d85373a-c325-4710-a78c-9b16f93406d9","cell_type":"code","source":"# Cell 8 — QAT and unstructured pruning wrappers (tfmot)\nfrom tensorflow_model_optimization.python.core.quantization.keras.default_8bit import (\n    default_8bit_quantize_registry, default_8bit_quantize_configs)\n_OUTCFG = default_8bit_quantize_configs.Default8BitOutputQuantizeConfig\n_REG = default_8bit_quantize_registry.Default8BitQuantizeRegistry()\n\ndef fresh_copy(model):\n    \"\"\"Independent copy (new layer objects), so later steps never modify the source model.\"\"\"\n    c = keras.models.clone_model(model)\n    c.set_weights(model.get_weights())\n    return c\n\ndef make_qat(model):\n    \"\"\"Whole-model QAT (with Conv+BN folding) when every layer is supported by tfmot.\n    Otherwise (Multiply and the stand-alone BN of the CCANet attention block, which tfmot does\n    not support), those layers get an output-only fake-quantizer, so QAT still models every\n    INT8 tensor that the converted TFLite model will use.\"\"\"\n    model = fresh_copy(model)\n    try:\n        return tfmot.quantization.keras.quantize_model(model), \"full\"\n    except Exception:\n        def annot(layer):\n            if _REG.supports(layer):\n                return tfmot.quantization.keras.quantize_annotate_layer(layer)\n            if isinstance(layer, (layers.Multiply, layers.BatchNormalization)):\n                return tfmot.quantization.keras.quantize_annotate_layer(layer, quantize_config=_OUTCFG())\n            return layer\n        ann = keras.models.clone_model(model, clone_function=annot)\n        with tfmot.quantization.keras.quantize_scope({\"Default8BitOutputQuantizeConfig\": _OUTCFG}):\n            q = tfmot.quantization.keras.quantize_apply(ann)\n        return q, \"annotated (output-quantized Multiply/BN)\"\n\ndef make_unstructured(model, target):\n    steps_per_epoch = int(np.ceil(len(Xtr) / BATCH))\n    end = steps_per_epoch * max(1, int(0.6 * UNSTR_EPOCHS))\n    sched = tfmot.sparsity.keras.PolynomialDecay(0.0, target, 0, end, frequency=max(1, steps_per_epoch//4))\n    def wrap(layer):\n        if isinstance(layer, (layers.Conv2D, layers.Dense)) and layer.name != \"eca_conv\":\n            return tfmot.sparsity.keras.prune_low_magnitude(layer, pruning_schedule=sched)\n        return layer\n    return keras.models.clone_model(fresh_copy(model), clone_function=wrap)   # wrapped layers keep the copied weights","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-21T13:43:29.939403Z","iopub.execute_input":"2026-11-21T13:43:29.939683Z","iopub.status.idle":"2026-11-21T13:43:29.955174Z","shell.execute_reply.started":"2026-11-21T13:43:29.939665Z","shell.execute_reply":"2026-11-21T13:43:29.954494Z"}},"outputs":[],"execution_count":8},{"id":"2d61cbeb-26f4-4744-ac71-636a4282a6ad","cell_type":"code","source":"# Cell 9 — TFLite conversion and evaluation\ndef to_tflite(model, int8=False, calib=None):\n    conv = tf.lite.TFLiteConverter.from_keras_model(model)\n    if int8:\n        conv.optimizations = [tf.lite.Optimize.DEFAULT]\n        if calib is not None:\n            def rep():\n                for i in range(len(calib)):\n                    yield [calib[i:i+1].astype(np.float32)]\n            conv.representative_dataset = rep\n        conv.target_spec.supported_ops = [tf.lite.OpsSet.TFLITE_BUILTINS_INT8]\n        conv.inference_input_type = tf.int8\n        conv.inference_output_type = tf.int8\n    return conv.convert()\n\ndef _interp(tfl, threads, batch):\n    it = tf.lite.Interpreter(model_content=tfl, num_threads=threads)\n    inp = it.get_input_details()[0]\n    if batch != 1:\n        it.resize_tensor_input(inp[\"index\"], [batch, N, 1])\n    it.allocate_tensors()\n    return it, it.get_input_details()[0], it.get_output_details()[0]\n\ndef _q(x, d):\n    if d[\"dtype\"] == np.int8:\n        s, z = d[\"quantization\"]\n        return np.clip(np.round(x / s + z), -128, 127).astype(np.int8)\n    return x.astype(np.float32)\n\ndef tflite_predict(tfl, X, batch=256):\n    try:\n        it, di, do = _interp(tfl, 4, batch)\n    except Exception:\n        batch = 1; it, di, do = _interp(tfl, 4, 1)\n    preds = []\n    for i in range(0, len(X), batch):\n        xb = X[i:i+batch]; nb = len(xb)\n        if nb < batch:\n            xb = np.concatenate([xb, np.zeros((batch-nb, N, 1), xb.dtype)])\n        it.set_tensor(di[\"index\"], _q(xb, di)); it.invoke()\n        preds.append(np.argmax(it.get_tensor(do[\"index\"])[:nb], axis=1))\n    return np.concatenate(preds)\n\ndef tflite_latency_ms(tfl):\n    it, di, _ = _interp(tfl, 1, 1)\n    x = _q(TEST[\"clean\"][0][:1], di)\n    for _ in range(LAT_WARMUP):\n        it.set_tensor(di[\"index\"], x); it.invoke()\n    ts = []\n    for _ in range(LAT_RUNS):\n        t0 = time.perf_counter(); it.set_tensor(di[\"index\"], x); it.invoke(); ts.append(time.perf_counter() - t0)\n    return 1000*float(np.median(ts))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-21T13:43:29.95602Z","iopub.execute_input":"2026-11-21T13:43:29.956392Z","iopub.status.idle":"2026-11-21T13:43:29.975973Z","shell.execute_reply.started":"2026-11-21T13:43:29.956372Z","shell.execute_reply":"2026-11-21T13:43:29.975359Z"}},"outputs":[],"execution_count":9},{"id":"748686ff-8445-4060-a4eb-0f42619415ac","cell_type":"code","source":"# Cell 10 — static (edge) metrics\ndef macs_dense(m):\n    \"\"\"Analytic multiply-accumulates of the dense (unpruned-equivalent) graph.\"\"\"\n    tot = 0\n    for l in m.layers:\n        if isinstance(l, layers.Conv2D):\n            _, k, cin, cout = l.kernel.shape\n            tot += int(l.output_shape[2]) * int(k) * int(cin) * int(cout)\n        elif isinstance(l, layers.Dense):\n            tot += int(np.prod(l.kernel.shape))\n    return tot\n\ndef peak_activation_elems(m):\n    \"\"\"Largest (inputs + output) activation footprint over all layers, in elements.\"\"\"\n    peak = 0\n    for l in m.layers:\n        if isinstance(l, keras.layers.InputLayer):\n            continue\n        ins = l.input if isinstance(l.input, list) else [l.input]\n        tot = sum(int(np.prod(x.shape[1:])) for x in ins) + int(np.prod(l.output.shape[1:]))\n        peak = max(peak, tot)\n    return peak\n\ndef nonzero_weights(m):\n    return int(sum(np.count_nonzero(v.numpy()) for v in m.trainable_weights))\n\ndef static_metrics(keras_model, tfl, int8):\n    return dict(params=n_trainable(keras_model), nonzero=nonzero_weights(keras_model),\n                tflite_kb=len(tfl)/1024, gzip_kb=len(gzip.compress(tfl, 9))/1024,\n                macs=macs_dense(keras_model),\n                peak_act_kb=peak_activation_elems(keras_model)*(1 if int8 else 4)/1024,\n                latency_ms=tflite_latency_ms(tfl))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-21T13:43:29.9784Z","iopub.execute_input":"2026-11-21T13:43:29.978757Z","iopub.status.idle":"2026-11-21T13:43:29.991848Z","shell.execute_reply.started":"2026-11-21T13:43:29.978731Z","shell.execute_reply":"2026-11-21T13:43:29.991071Z"}},"outputs":[],"execution_count":10},{"id":"19a07f7c-09d2-48c8-812f-e1f44d5559fe","cell_type":"code","source":"# Cell 11 — one complete run (one seed, one architecture)\nRES = os.path.join(ROOT, \"results\")\nCSV_ALL = os.path.join(RES, \"results_all.csv\")\nCSV_CLS = os.path.join(RES, \"perclass_f1_20dB.csv\")\nLOG = os.path.join(RES, \"run_log.jsonl\")\n\ndef evaluate_variant(seed, arch, variant, keras_model, tfl, int8, extra):\n    st = static_metrics(keras_model, tfl, int8)\n    open(os.path.join(ROOT, \"models\", f\"{arch}_{variant}_s{seed}.tflite\"), \"wb\").write(tfl)\n    rows, cls_rows, cms = [], [], {}\n    for tag, (X, y) in TEST.items():\n        p = tflite_predict(tfl, X)\n        rows.append(dict(seed=seed, arch=arch, variant=variant, snr=tag,\n                         acc=accuracy_score(y, p), macro_f1=f1_score(y, p, average=\"macro\"), **st, **extra))\n        if tag == \"20dB\":\n            f1c = f1_score(y, p, average=None, labels=range(NC))\n            cls_rows.append(dict(seed=seed, arch=arch, variant=variant, **{CLASSES[i]: f1c[i] for i in range(NC)}))\n            cms[f\"{arch}|{variant}|{seed}\"] = confusion_matrix(y, p, labels=range(NC))\n    r20 = [r for r in rows if r[\"snr\"] == \"20dB\"][0]\n    print(f\"   {variant:9s} size={st['tflite_kb']:7.1f} KB  F1@clean={rows[0]['macro_f1']:.4f}  \"\n          f\"F1@20dB={r20['macro_f1']:.4f}  F1@10dB={rows[-2]['macro_f1']:.4f}  F1@fdev={rows[-1]['macro_f1']:.4f}  lat={st['latency_ms']:.3f} ms\")\n    return rows, cls_rows, cms\n\ndef run_one(seed, arch):\n    keras.backend.clear_session()\n    keras.utils.set_random_seed(seed)\n    calib_idx = np.random.default_rng(seed).choice(len(Xtr), CALIB_N, replace=False)\n    calib = Xtr[calib_idx]                     # noisy + clean mix, drawn from training data only\n    rows, cls_rows, cms, info = [], [], {}, {\"seed\": seed, \"arch\": arch}\n    def add(variant, km, tfl, int8, extra=None):\n        r, c, cm = evaluate_variant(seed, arch, variant, km, tfl, int8, extra or {})\n        rows.extend(r); cls_rows.extend(c); cms.update(cm)\n\n    # 1) FP32 baseline\n    t0 = time.time()\n    fp = BUILDERS[arch]()\n    h = fit(fp, EPOCHS, LR)\n    info[\"fp32_epochs\"] = len(h.history[\"loss\"]); info[\"fp32_train_s\"] = time.time() - t0\n    fp.save(os.path.join(ROOT, \"models\", f\"{arch}_fp32_s{seed}.keras\"))\n    add(\"fp32\", fp, to_tflite(fp), False)\n\n    # 2) PTQ-INT8 (full-integer, calibrated on CALIB_N noisy training signals)\n    add(\"ptq_int8\", fp, to_tflite(fp, int8=True, calib=calib), True)\n\n    # 3) QAT-INT8\n    q, mode = make_qat(fp); info[\"qat_mode\"] = mode\n    fit(q, QAT_EPOCHS, QAT_LR)\n    add(\"qat_int8\", fp, to_tflite(q, int8=True, calib=calib), True, {\"qat_mode\": mode})\n\n    # 4) Iterative structured pruning 25 -> 50 -> 75 %, fine-tuning after every step\n    cur = fp\n    for frac in PRUNE_STEPS:\n        cur, keep = structured_prune(cur, arch, frac)\n        fit(cur, FT_EPOCHS, FT_LR)\n        tag = f\"sp{int(frac*100)}\"\n        if tag in VARIANTS:\n            add(tag, cur, to_tflite(cur), False, {\"widths\": str(keep)})\n            # 5) structured pruning + QAT\n            qp, mode = make_qat(cur)\n            fit(qp, QAT_EPOCHS, QAT_LR)\n            add(tag + \"_qat\", cur, to_tflite(qp, int8=True, calib=calib), True, {\"widths\": str(keep), \"qat_mode\": mode})\n\n    # 6) Unstructured magnitude pruning (Zhu & Gupta 2017 schedule), FP32 storage\n    for target in UNSTR_TARGETS:\n        pm = make_unstructured(fp, target)\n        fit(pm, UNSTR_EPOCHS, FT_LR, extra_cb=[tfmot.sparsity.keras.UpdatePruningStep()],\n            patience=UNSTR_EPOCHS, early_stop=False)\n        sm = tfmot.sparsity.keras.strip_pruning(pm)\n        prunable = [l.kernel.numpy() for l in sm.layers\n                    if isinstance(l, (layers.Conv2D, layers.Dense)) and l.name != \"eca_conv\"]\n        achieved = 1 - sum(np.count_nonzero(k) for k in prunable) / sum(k.size for k in prunable)\n        assert abs(achieved - target) < 0.02, f\"sparsity {achieved:.3f} != target {target}\"\n        add(f\"up{int(target*100)}\", sm, to_tflite(sm), False, {\"target_sparsity\": target})\n\n    info[\"total_s\"] = time.time() - t0\n    return rows, cls_rows, cms, info","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-21T13:43:29.992804Z","iopub.execute_input":"2026-11-21T13:43:29.99307Z","iopub.status.idle":"2026-11-21T13:43:30.015562Z","shell.execute_reply.started":"2026-11-21T13:43:29.99304Z","shell.execute_reply":"2026-11-21T13:43:30.014735Z"}},"outputs":[],"execution_count":11},{"id":"b0d3644a-fe68-44f2-ae33-0771b7944d98","cell_type":"code","source":"# Cell 12 — main loop over seeds and architectures (resumable)\ndone = set()\nif os.path.exists(CSV_ALL) and not QUICK:\n    prev = pd.read_csv(CSV_ALL)\n    done = set(zip(prev.seed, prev.arch))\nelse:\n    for f in [CSV_ALL, CSV_CLS, LOG]:\n        if os.path.exists(f): os.remove(f)\n\nfor see